<!--
  Wazuh MANAGER decoder, for /var/ossec/etc/decoders/local_decoder.xml
  Then: /var/ossec/bin/wazuh-control restart

  Caetra sends "caetra_siem: {json}" over UDP with no syslog header (see
  src/utils/logger_setup.py), so Wazuh's pre-decoder doesn't extract a
  program_name; match the fixed "caetra_siem: " prefix instead and hand
  the JSON body after it to Wazuh's JSON decoder, so fields like
  shield/state/machine/message land under data.* in the alert.
-->
<decoder name="caetra-siem">
  <prematch>^caetra_siem: </prematch>
  <plugin_decoder offset="after_prematch">JSON_Decoder</plugin_decoder>
</decoder>
